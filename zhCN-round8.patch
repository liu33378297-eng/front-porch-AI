@@ -25,6 +25,20 @@ part of '../chat_service.dart';
 /// ~1.9k-line `_generateResponse` method during the god-file split
 /// (docs/design/god-file-elimination.md). Zero behaviour change.
 extension ChatServiceGenerationBlocks on ChatService {
+  /// True when one of the recent user-authored turns uses Chinese. Looking
+  /// back several turns means an English one-tap action does not accidentally
+  /// switch an otherwise Chinese roleplay back to English.
+  bool _recentUserConversationUsesChinese() {
+    final recentUserText = _messages
+        .where((message) => message.isUser)
+        .toList()
+        .reversed
+        .take(5)
+        .map((message) => message.text)
+        .join('\n');
+    return RegExp(r'[\u3400-\u4DBF\u4E00-\u9FFF]').hasMatch(recentUserText);
+  }
+
   Future<void> _assembleGenerationBlocks(_GenTurn t) async {
     // Days lived off-screen land before any prompt reads a body.
     if (t.mode == GenerationMode.normal) _needsPass.landLivedBeatBeforeReply();
