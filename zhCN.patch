new file mode 100644
index 0000000..0b31d95
--- /dev/null
+++ b/build-zhCN-windows.bat
@@ -0,0 +1,44 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+
+where flutter >nul 2>nul
+if errorlevel 1 (
+  echo [ERROR] Flutter SDK not found. Install Flutter and add flutter\bin to PATH.
+  pause
+  exit /b 1
+)
+where npm >nul 2>nul
+if errorlevel 1 (
+  echo [ERROR] Node.js/npm not found. Install a supported Node.js LTS release.
+  pause
+  exit /b 1
+)
+
+echo [1/4] Installing web UI dependencies...
+cd web_ui
+call npm ci
+if errorlevel 1 goto fail
+echo [2/4] Building web UI...
+call npm run build
+if errorlevel 1 goto fail
+cd ..
+
+echo [3/4] Fetching Flutter dependencies...
+call flutter pub get
+if errorlevel 1 goto fail
+
+echo [4/4] Building Windows app...
+call flutter build windows
+if errorlevel 1 goto fail
+
+echo.
+echo Build complete. Look in build\windows\x64\runner\Release\
+pause
+exit /b 0
+
+:fail
+echo.
+echo [ERROR] Build failed. Review the error shown above.
+pause
+exit /b 1
