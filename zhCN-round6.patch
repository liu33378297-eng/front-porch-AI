+  return labels[value] ?? value;
+}
+
+String zhCnMoodLabel(String value) {
+  const labels = <String, String>{
+    'contemplative': '沉思',
+    'curious': '好奇',
+    'happy': '开心',
+    'joyful': '愉悦',
+    'sad': '悲伤',
+    'angry': '愤怒',
+    'anxious': '焦虑',
+    'nervous': '紧张',
+    'affectionate': '充满爱意',
+    'amused': '觉得有趣',
+    'confident': '自信',
+    'confused': '困惑',
+    'embarrassed': '尴尬',
+    'excited': '兴奋',
+    'frustrated': '沮丧',
+    'hopeful': '抱有希望',
+    'lonely': '孤独',
+    'melancholy': '忧郁',
+    'peaceful': '平静',
+    'playful': '俏皮',
+    'relieved': '如释重负',
+    'romantic': '浪漫',
+    'shy': '害羞',
+    'surprised': '惊讶',
+    'tender': '温柔',
+    'worried': '担忧',
+    'neutral': '平静',
+  };
+  return labels[value.trim().toLowerCase()] ?? value;
+}
+
+String zhCnAmbitionStage(String value) {
+  const labels = <String, String>{
+    'achieved': '已达成',
+    'nearly there': '即将达成',
+    'halfway there': '已完成一半',
+    'gaining ground': '逐步推进',
+    'just beginning': '刚刚起步',
+  };
+  return labels[value] ?? value;
+}
+
+String zhCnShortDate(String value) {
+  const weekdays = <String, String>{
+    'Mon': '周一',
+    'Tue': '周二',
+    'Wed': '周三',
+    'Thu': '周四',
+    'Fri': '周五',
+    'Sat': '周六',
+    'Sun': '周日',
+  };
+  const months = <String, String>{
+    'Jan': '1月',
+    'Feb': '2月',
+    'Mar': '3月',
+    'Apr': '4月',
+    'May': '5月',
+    'Jun': '6月',
+    'Jul': '7月',
+    'Aug': '8月',
+    'Sep': '9月',
+    'Oct': '10月',
+    'Nov': '11月',
+    'Dec': '12月',
+  };
+  final match = RegExp(
+    r'^(Mon|Tue|Wed|Thu|Fri|Sat|Sun),?\s+([A-Z][a-z]{2})\s+(\d{1,2})$',
+  ).firstMatch(value.trim());
+  if (match == null) return value;
+  final weekday = weekdays[match.group(1)]!;
+  final month = months[match.group(2)];
+  final day = match.group(3);
+  if (month == null) return value;
+  return '$month$day日 $weekday';
+}
