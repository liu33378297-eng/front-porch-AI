+    'Disliked': '反感',
+    'Hostile': '敌对',
+    'Adversarial': '针锋相对',
+    'Disdain': '轻蔑',
+    'Contempt': '蔑视',
+    'Vitriolic': '刻薄敌意',
+    'Disappointed': '失望',
+    'Fractured': '关系破裂',
+    'Broken Trust': '信任破裂',
+    'Deep Resentment': '深切怨恨',
+    'Blind Trust': '盲目信任',
+    'Implicit Trust': '完全信赖',
