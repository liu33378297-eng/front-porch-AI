+    'Learning Positive': '开始信任',
+    'Warming': '逐渐亲近',
+    'Cautious': '谨慎',
+    'Guarded': '戒备',
+    'Skeptical': '怀疑',
+    'Wary': '警惕',
+    'Suspicious': '猜疑',
+    'Distrustful': '不信任',
+    'Paranoid': '多疑',
+    'Unknown': '未知',
