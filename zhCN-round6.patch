+/// Simplified Chinese labels for the chat UI. These helpers are presentation-only:
+/// stored values and model-facing terminology remain unchanged.
+String zhCnNeedLabel(String value) {
+  switch (value.toLowerCase()) {
+    case 'hunger':
+      return '饥饿';
+    case 'bladder':
+      return '膀胱';
+    case 'energy':
+      return '精力';
+    case 'social':
+      return '社交';
+    case 'fun':
+      return '娱乐';
+    case 'hygiene':
+      return '卫生';
+    case 'comfort':
+      return '舒适';
+    default:
+      return value;
+  }
+}
